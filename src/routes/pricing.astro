---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import { paidTracks } from '../data/site';
import { passes, passChoiceNote, passLengthNote, stackingNote, launchPricingNote, reminderNote, morTermsNote, internationalPrice, pricingPublished } from '../data/payment';
---

<Base
  title="Pricing"
  description={`Rsquared Academy launch pricing from 26 January 2027: ₹${passes.monthly.priceINR.toLocaleString('en-IN')} for ${passes.monthly.days} days, ₹${passes.quarterly.priceINR.toLocaleString('en-IN')} for ${passes.quarterly.days} days or ₹${passes.annual.priceINR.toLocaleString('en-IN')} for ${passes.annual.days} days. Prepaid, with no automatic renewal.`}
  noindex={!pricingPublished}
>
  <section class="sec page-head" aria-labelledby="pricing-h">
    <div class="wrap flex flex-col gap-5">
      <span class="eyebrow">Pricing</span>
      <h1 id="pricing-h" class="t-h1 max-w-[760px]">Three passes. Pay once, learn at your pace.</h1>
      <p class="t-lead max-w-[680px]">{passChoiceNote} All three cover all paid tracks. Each is a prepaid, one-time payment with no automatic renewal.</p>
      <div><Badge tone="soon">Paid tracks open from 26 January 2027</Badge></div>
    </div>
  </section>

  <section class="sec flush" aria-labelledby="plan-h">
    <div class="wrap">
      <h2 id="plan-h" class="t-h2 mb-6">India launch prices</h2>
      <div class="three">
        {Object.values(passes).map((pass) => (
          <article class="plan flex flex-col gap-4 min-w-0">
            <h3 class="t-h3">{pass.name}</h3>
            <p class="price">₹{pass.priceINR.toLocaleString('en-IN')}</p>
            <p>{pass.days} days of access.</p>
            <p class="t-muted">Prepaid. No automatic renewal.</p>
            <p class="t-small t-muted">Outside India: {internationalPrice}.</p>
          </article>
        ))}
      </div>
      <p class="t-small t-muted mt-6">Prices apply from 26 January 2027. These are the amounts you pay in India.</p>
      <div class="mt-6"><Button href="/#signup">Hear when the tracks open</Button></div>
    </div>
  </section>

  <section class="sec bg-surface" aria-labelledby="launch-h">
    <div class="wrap flex flex-col gap-4">
      <h2 id="launch-h" class="t-h2">Launch pricing, one time only</h2>
      <p class="t-muted max-w-[680px]">{launchPricingNote}</p>
      <p class="t-muted max-w-[680px]">{passLengthNote} {stackingNote}</p>
      <p class="t-muted max-w-[680px]">Payments in India are processed by Razorpay. {morTermsNote}</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="tracks-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <h2 id="tracks-h" class="t-h2">Paid tracks</h2>
        <p class="t-muted">One business dataset, the ShopVibe online shop, runs through every course. You build the skills analysts use, in your browser, with instant feedback. Paid tracks open from 26 January 2027, with courses released in stages.</p>
        <ul class="checklist">
          <li>All three paid tracks: Data Analyst with R, Data Analyst with Python and SQL for Data Analysts.</li>
          <li>Every released lesson and exercise, with instant feedback in your browser.</li>
          <li>Updates and courses released while your pass is active.</li>
          <li>Email support.</li>
        </ul>
      </div>
      <div class="three rsa-card-grid rsa-card-grid--tracks">
        {paidTracks.map((track) => (
          <article class="rsa-card" id={track.id}>
            <div class="rsa-card-badges"><Badge tone="soon">Opens from 26 January 2027</Badge></div>
            <h3 class="rsa-card-title">{track.title}</h3>
            <p class="rsa-card-text">{track.summary}</p>
            <ul class="t-small t-muted track-list">
              {track.curriculum.map((course) => <li>{course}</li>)}
            </ul>
            <p class="t-small t-muted track-note">{track.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec flush" aria-labelledby="free-h">
    <div class="wrap">
      <div class="split bg-surface-tint rounded-lg p-10">
        <div class="flex flex-col gap-2 min-w-0">
          <h2 id="free-h" class="t-h2">Free to start</h2>
          <p class="t-muted">Introduction to R, Data Wrangling with dplyr and Data Viz with ggplot2 are free. They open soon.</p>
          <p class="t-muted">Lessons 0–2 of every course are free to try before you buy.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <Button variant="secondary" href="/courses/">See the free courses</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="sec flush" aria-labelledby="know-h">
    <div class="wrap legal">
      <h2 id="know-h" class="t-h2">What to know</h2>
      <ul>
        <li>{reminderNote}</li>
        <li>Your progress is kept after your pass ends. Free courses and free lessons stay free. See <a href="/delivery/">Delivery and access</a>.</li>
        <li>{passes.quarterly.exact} and {passes.annual.exact}: a full refund within 14 days of purchase if you have completed less than 20% of the lessons in every paid track (no single track at 20% or more).</li>
        <li>{passes.monthly.exact}: no refunds, except a duplicate charge or a technical problem we can't fix. See the <a href="/refund/">Refund and cancellation policy</a>.</li>
        <li>We never see your card details. See <a href="/privacy/">Privacy</a>.</li>
        <li>Questions about an order or a track? See <a href="/contact/">Contact</a> or <a href="/support/">Support</a>.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: 96px;
    padding-bottom: 64px;
  }
  .plan {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }
  .price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 54px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .checklist {
    margin: 0;
    padding-left: 24px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink-muted);
  }
  .three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .track-list {
    margin: 0;
    padding-left: 20px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .legal {
    max-width: var(--text-max);
  }
  .legal ul {
    margin: 0;
    padding-left: 24px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .flush {
    padding-top: 0;
  }
  @media (max-width: 860px) {
    .page-head {
      padding-block: var(--space-12);
    }
    .three,
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .price {
      font-size: 38px;
      line-height: 42px;
    }
  }
</style>
