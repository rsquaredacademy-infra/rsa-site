---
import Badge from './Badge.astro';
import CourseVisual from './CourseVisual.astro';
import type { BadgeTone } from '../data/site';
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  badges?: { text: string; tone: BadgeTone }[];
  footer?: string;
  href?: string;
  /** 1, 2 or 3: the course's picture from the app home (Courses page). */
  visual?: number;
}
const { title, description, eyebrow, badges = [], footer, href, visual } = Astro.props;
const Tag = href ? 'a' : 'article';
const cardClass = visual ? 'rsa-card rsa-card--visual' : 'rsa-card';
---
<Tag class={cardClass} href={href}>
  {visual && <div class="rsa-card-visual"><CourseVisual order={visual} /></div>}
  <div class="rsa-card-badges">{badges.map((b) => <Badge tone={b.tone}>{b.text}</Badge>)}</div>
  <div>
    {eyebrow && <div class="rsa-card-eyebrow">{eyebrow}</div>}
    <h3 class="rsa-card-title">{title}</h3>
  </div>
  <p class="rsa-card-text">{description}</p>
  {footer && <div class="rsa-card-foot">{footer}</div>}
</Tag>
