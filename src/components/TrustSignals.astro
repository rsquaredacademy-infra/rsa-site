---
import snapshot from '../data/trust-signals.json';
import { ebooks } from '../data/ebooks';
import { packageGroups } from '../data/packages';

const { cran } = snapshot;
const downloadsInMillions = Math.floor(cran.total / 100_000) / 10;
const packages = packageGroups.flatMap((group) => group.pkgs);
const date = (value: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(value));
---

<section class="sec bg-surface" aria-labelledby="trust-h" id="trust-signals">
  <div class="wrap flex flex-col gap-8">
    <div class="flex flex-col gap-4 max-w-[760px]">
      <h2 id="trust-h" class="t-h2">Built by the author of olsrr, descriptr and rfm</h2>
      <p class="t-muted">Learn from an experienced data science consultant, author of popular R packages and eBooks</p>
    </div>
    <div class="trust-grid">
      <article class="trust-card">
        <h3 class="t-h3">{downloadsInMillions} million downloads</h3>
        <ul class="package-logos" aria-label="R packages">
          {packages.map((pkg) => (
            <li><a href={pkg.docs}><img src={pkg.hex} alt={`${pkg.name} R package logo`} width="86" height="100" loading="lazy" /></a></li>
          ))}
        </ul>
        <p class="t-small t-muted">CRAN downloads, all time, through <time datetime={cran.end}>{date(cran.end)}</time>.</p>
        <p class="t-small t-muted">Source: <a href={cran.source}>cranlogs download totals</a>. Posit CRAN mirror only; other mirrors are not counted. Available logs start in October 2012. Downloads are not a count of people.</p>
        <a href="/open-source/" class="card-action">Explore our open-source work<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
      </article>
      <article class="trust-card">
        <h3 class="t-h3">{ebooks.length} public eBooks</h3>
        <ul class="book-covers" aria-label="eBooks">
          {ebooks.map((book) => (
            <li><a href={book.web}><img src={book.cover} alt={`${book.title} eBook cover`} width="300" height="400" loading="lazy" /></a></li>
          ))}
        </ul>
        <p class="t-small t-muted">Free to read online, from your first R code to wrangling, charts and SQL.</p>
        <a href="/resources/" class="card-action">Browse the free eBooks<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
      </article>
    </div>
  </div>
</section>

<style>
  .trust-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .trust-card { display: flex; flex-direction: column; align-items: start; gap: var(--space-3); min-width: 0; padding: var(--space-6); background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .trust-card p { margin: 0; }
  /* Card action: tinted pill with an arrow that nudges right on hover. */
  .card-action { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; margin-top: auto; padding: 0 18px; border-radius: 999px; background: var(--surface-tint); color: var(--link); font-weight: 600; text-decoration: none; transition: background-color .15s, color .15s; }
  .card-action svg { flex: none; transition: transform .15s; }
  .card-action:hover { background: var(--brand); color: var(--bg); }
  .card-action:hover svg { transform: translateX(3px); }
  .card-action:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .card-action, .card-action svg { transition: none; } .card-action:hover svg { transform: none; } }
  .package-logos, .book-covers { display: grid; width: 100%; gap: var(--space-4); list-style: none; margin: var(--space-3) 0; padding: 0; }
  .package-logos { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .book-covers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .package-logos a, .book-covers a { display: block; border-radius: var(--radius-sm); }
  .package-logos a { width: 100%; max-width: 86px; }
  .book-covers a { width: 100%; max-width: 112px; }
  /* These two hex files have less margin than the rest; scale them to match. */
  .package-logos img[src*='yahoofinancer'], .package-logos img[src*='standby'] { transform: scale(0.94); }
  .package-logos img { display: block; width: 100%; height: auto; aspect-ratio: 86 / 100; object-fit: contain; }
  .book-covers img { display: block; width: 100%; max-width: 112px; height: auto; aspect-ratio: 3 / 4; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  /* Packages and eBooks side by side on wide screens; stacked on phones and tablets. */
  @media (min-width: 900px) {
    .trust-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Same row height in both cards, so the hex rows and cover rows line up. */
    .package-logos, .book-covers { grid-auto-rows: 108px; align-items: center; justify-items: center; }
    .package-logos { column-gap: var(--space-2); }
    .package-logos a, .book-covers a { height: 100%; display: flex; align-items: center; justify-content: center; }
    .package-logos img { height: 100%; max-height: 108px; }
    .book-covers img { height: 108px; width: 81px; }
  }
</style>
