---
import { inside } from '../../data/home';
import { lessonTiles } from '../../data/site';
---
<section class="inside-section" aria-labelledby="inside-h" id="inside">
  <div class="wrap">
    <div class="section-heading">
      <div><p class="eyebrow">The learning experience</p><h2 id="inside-h" class="t-h2">What's inside</h2></div>
      <p class="t-lead">Read a little. Try it. See what happens.</p>
    </div>
    <ul class="inside-grid">
      {inside.filter((feature) => !feature.wide).map((feature) => {
        const image = feature.image;
        const alt = feature.image === 'lesson-stepthrough'
          ? 'A step-through in three steps: a small table of products and sizes, the two Large rows highlighted by filter(size == "Large"), then only those two rows kept.'
          : feature.image === 'lesson-datasets-panel'
            ? 'The Datasets panel: sales.csv (160 rows, 7 columns) expanded to its first rows, with stores.csv (9 rows, 6 columns) below.'
            : lessonTiles.find((tile) => tile.image === feature.image)?.alt ?? '';
        return (
        <li class="inside-card">
          <picture class="illustration-frame">
            <source srcset={`/images/home/${image}-dark.webp`} media="(prefers-color-scheme: dark)" />
            <img src={`/images/home/${image}.webp`} width={800} height={800} loading="lazy" decoding="async" alt={alt} />
          </picture>
          <p class="feature-label eyebrow">{feature.label}</p>
          <h3 class="t-h3">{feature.title}</h3>
          <p class="t-muted">{feature.line}</p>
        </li>
      ); })}
    </ul>
    {inside.filter((feature) => feature.wide).map((feature) => (
      <div class="inside-wide">
        <picture class="illustration-frame">
          <source srcset={`/images/home/${feature.image}-dark.webp`} media="(prefers-color-scheme: dark)" />
          <img src={`/images/home/${feature.image}.webp`} width={1520} height={736} loading="lazy" decoding="async" alt="Two report cards from the Intro to Python course home, from the shop owner’s 2025 data: 4,182 completed orders, ₹65.65 lakh revenue and a ₹1,570 average order; and order ORD-03159 labelled with its total to pay, ₹10,994.00." />
        </picture>
        <div class="inside-wide-text">
          <p class="feature-label eyebrow">{feature.label}</p>
          <h3 class="t-h3">{feature.title}</h3>
          <p class="t-muted">{feature.line}</p>
          {feature.points && <ul class="inside-wide-points">{feature.points.map((point) => <li>{point}</li>)}</ul>}
        </div>
      </div>
    ))}
    <div class="resume-line">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11a9 9 0 1 1 2.5 7"/><path d="M3 4v7h7"/><path d="M12 7v5l3 2"/></svg>
      <p><strong>Pick up where you left off.</strong> Progress is saved in this browser.</p>
    </div>
  </div>
</section>
<style>
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: var(--home-content-gap); }
  .section-heading .eyebrow { margin: 0 0 12px; }
  .inside-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; list-style: none; padding: 0; margin: 0; }
  .inside-card { display: grid; grid-template-rows: subgrid; grid-row: span 3; row-gap: 10px; min-width: 0; overflow: hidden; padding-bottom: 18px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); }
  .inside-card .illustration-frame { aspect-ratio: 1; }
  .inside-card img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .feature-label { margin: 10px 0 0; }
  .inside-wide { display: grid; grid-template-columns: minmax(0, 640px) minmax(0, 1fr); align-items: center; gap: 40px; margin-top: 24px; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); }
  .inside-wide .illustration-frame { align-self: stretch; display: flex; align-items: center; padding: 16px; }
  .inside-wide img { display: block; width: 100%; height: auto; }
  .inside-wide-text { padding: 24px 40px 24px 0; }
  .inside-wide-text h3 { font-size: 24px; line-height: 32px; margin: 0 0 8px; }
  .inside-wide-text .t-muted { font-size: 18px; line-height: 28px; margin: 0; }
  .inside-wide-points { margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .inside-wide-points li { position: relative; padding-left: 28px; font-size: 16px; line-height: 24px; color: var(--ink); }
  .inside-wide-points li::before { content: "✓"; position: absolute; left: 4px; top: 0; color: var(--brand); font-weight: 700; }
  :global(.home) .inside-wide .illustration-frame { border: 0; border-radius: 0; box-shadow: none; }
  @media (max-width: 1100px) { .inside-wide { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; } }
  @media (max-width: 860px) {
    .inside-wide { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .inside-wide .illustration-frame { padding: 12px 12px 0; }
    .inside-wide-text { padding: 20px 18px 24px; }
    .inside-wide-text h3 { font-size: 18px; line-height: 26px; }
    .inside-wide-text .t-muted { font-size: 16px; line-height: 24px; }
  }
  .resume-line { display: flex; align-items: center; justify-content: center; gap: 12px; padding-block: 24px; margin-top: var(--home-content-gap); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--ink-muted); }
  .resume-line svg { flex: none; color: var(--brand); }
  .resume-line p { margin: 0; }
  .resume-line strong { color: var(--ink); font-weight: 600; }
  :global(.home) .inside-card .illustration-frame { border: 0; border-radius: 0; box-shadow: none; }
  :global(.home) .inside-card h3, :global(.home) .inside-card > .t-muted { padding-inline: 18px; }
  .inside-card h3 { font-size: 18px; line-height: 26px; }
  .inside-card > .t-muted { font-size: 16px; line-height: 24px; }
  :global(.home) .feature-label { display: none; }
  @media (max-width: 1100px) {
    .inside-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) { .section-heading { align-items: start; flex-direction: column; gap: 12px; } }
  @media (max-width: 600px) {
    .inside-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .inside-card:nth-child(n) { grid-template-rows: auto; grid-row: auto; }
    .resume-line { align-items: start; justify-content: start; }
  }
</style>
