---
import Wordmark from './Wordmark.astro';
import { footerColumns, footerLegalLinks, contactEmail } from '../data/site';
import { pricingPublished } from '../data/payment';
const year = new Date().getFullYear();
const legalLinks = pricingPublished
  ? [...footerLegalLinks, { label: 'Pricing', href: '/pricing/' }]
  : footerLegalLinks;
---
<footer class="rsa-footer">
  <div class="rsa-footer-inner">
    <div class="rsa-footer-about">
      <Wordmark />
      <p>Interactive R courses for data analysis, plus free eBooks and open-source R packages.</p>
      <p>Contact: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </div>
    {footerColumns.map((c) => (
      <div>
        <h3>{c.title}</h3>
        <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}
    <div class="rsa-footer-base">
      <span>© {year} Rsquared Academy</span>
      <span>{legalLinks.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}</span>
    </div>
  </div>
</footer>
