---
import type { CourseFaq } from '../data/course-faqs';

interface Props {
  faqs: CourseFaq[];
}
const { faqs } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<section class="sec bg-surface" aria-labelledby="faq-h" id="course-faq">
  <div class="wrap">
    <div class="faq-content flex flex-col gap-6">
      <h2 class="t-h2" id="faq-h">Frequently asked questions</h2>
      <div>
        {faqs.map(({ question, answer }, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{question}</summary>
            <p class="t-muted">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />

<style>
  .faq-content { max-width: 760px; }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item:first-child { border-top: 1px solid var(--line); }
  summary { padding: var(--space-4) 0; min-height: 44px; cursor: pointer; font-weight: 600; }
  summary:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; border-radius: var(--radius-sm); }
  .faq-item p { padding: 0 0 var(--space-5); max-width: 65ch; }
</style>
