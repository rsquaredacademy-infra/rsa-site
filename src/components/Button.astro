---
interface Props {
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'md' | 'sm';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}
const { variant = 'primary', size = 'md', href, type = 'button', class: extra } = Astro.props;
const cls = ['rsa-btn', `rsa-btn-${variant}`, size === 'sm' && 'rsa-btn-sm', extra].filter(Boolean).join(' ');
---
{href ? <a class={cls} href={href}><slot /></a> : <button class={cls} type={type}><slot /></button>}
