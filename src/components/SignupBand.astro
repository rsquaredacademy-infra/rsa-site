---
// Email sign-up, posted to Zoho Campaigns via site-kit enhance mode.
import Button from './Button.astro';
interface Props { title?: string; text?: string; button?: string; id?: string; site: string }
const {
  title = 'Get updates',
  text = 'Hear when the free courses open in December 2026. We email about once a month.',
  button = 'Get updates',
  id = 'signup-email',
  site,
} = Astro.props;
---
<section class="rsa-signup" id="signup">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <form novalidate data-rsa-signup data-site={site}>
    <p hidden><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" data-rsa-signup-hp /></label></p>
    <label for={id}>Email</label>
    <div class="rsa-signup-row">
      <input id={id} name="email" class="rsa-input" type="email" autocomplete="email" placeholder="name@example.com" required aria-describedby={`${id}-msg`} />
      <Button type="submit">{button}</Button>
    </div>
    <div id={`${id}-msg`} class="rsa-help" data-rsa-signup-status role="status" aria-live="polite">No spam. Unsubscribe any time.</div>
  </form>
</section>
