---
import Button from './Button.astro';
---
<figure id="learning-explainer" class="learning-explainer">
  <div class="explainer-inline">
    <a class="explainer-poster" href="/media/explainer/how-learning-works.mp4" aria-label="Play: how learning works here (1 min) — Watch · 1 min" hidden>
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="/media/explainer/how-learning-works-poster-dark.webp" />
        <img src="/media/explainer/how-learning-works-poster.webp" width="1920" height="1080" alt="" loading="lazy" decoding="async" />
      </picture>
      <span class="explainer-watch" aria-hidden="true">
        <span class="explainer-play" data-theme="light"><svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M9 5 20 12 9 19Z" /></svg></span>
        <span class="explainer-watch-label">Watch · 1 min</span>
      </span>
    </a>
    <video
      controls
      preload="none"
      playsinline
      width="1920"
      height="1080"
      poster="/media/explainer/how-learning-works-poster.webp"
      aria-label="How learning works here (57 s)"
    >
      <source src="/media/explainer/how-learning-works.mp4" type="video/mp4" />
      <track kind="captions" src="/media/explainer/how-learning-works.vtt" srclang="en" label="English" />
    </video>
  </div>
  <dialog id="learning-explainer-dialog" aria-labelledby="explainer-title">
    <span class="explainer-focus-guard" data-focus-start tabindex="0"></span>
    <div class="explainer-header">
      <h2 id="explainer-title" class="t-h3">How learning works here (1 min)</h2>
      <Button variant="secondary" class="explainer-close">Close</Button>
    </div>
    <div class="explainer-player"></div>
    <span class="explainer-focus-guard" data-focus-end tabindex="0"></span>
  </dialog>
  <figcaption class="t-small t-muted">How learning works here (57 s)</figcaption>
</figure>

<script>
  import { trackEvent } from '../lib/analytics';

  const figure = document.querySelector<HTMLElement>('.learning-explainer');
  const dialog = document.querySelector<HTMLDialogElement>('#learning-explainer-dialog');
  const video = figure?.querySelector<HTMLVideoElement>('video');
  const poster = figure?.querySelector<HTMLAnchorElement>('.explainer-poster');
  const close = dialog?.querySelector<HTMLButtonElement>('.explainer-close');
  const player = dialog?.querySelector<HTMLElement>('.explainer-player');
  const inlinePlayer = figure?.querySelector<HTMLElement>('.explainer-inline');

  if (video) {
    const dark = matchMedia('(prefers-color-scheme: dark)');
    const updatePoster = () => {
      video.poster = `/media/explainer/how-learning-works-poster${dark.matches ? '-dark' : ''}.webp`;
    };
    updatePoster();
    dark.addEventListener('change', updatePoster);
  }

  if (video && poster && inlinePlayer) {
    video.hidden = true;
    poster.hidden = false;
    poster.setAttribute('role', 'button');
    poster.addEventListener('click', (event) => {
      event.preventDefault();
      poster.hidden = true;
      video.hidden = false;
      video.focus({ preventScroll: true });
      void video.play().catch(() => { /* Native controls remain available if playback is blocked. */ });
    });
    poster.addEventListener('keydown', (event) => {
      if (event.key === ' ') { event.preventDefault(); poster.click(); }
    });
    video.addEventListener('play', () => {
      const placement = dialog?.open ? 'hero' : 'section';
      trackEvent('video_start', { placement, page: window.location.pathname });
    });
  }

  if (figure && dialog && video && poster && close && player && inlinePlayer && typeof dialog.showModal === 'function') {
    let trigger: HTMLAnchorElement | null = null;

    function enhance(link: HTMLAnchorElement) {
      link.setAttribute('role', 'button');
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', dialog!.id);
      link.addEventListener('click', (event) => {
        event.preventDefault();
        trigger = link;
        video!.pause();
        player!.append(video!);
        video!.hidden = false;
        poster!.hidden = false;
        const scrollbar = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.setProperty('--explainer-scrollbar', `${scrollbar}px`);
        dialog!.showModal();
        close!.focus();
        // Playback follows an explicit click, including with reduced motion enabled.
        video!.muted = false;
        void video!.play().catch(() => { /* Native controls remain available if playback is blocked. */ });
      });
      link.addEventListener('keydown', (event) => {
        if (event.key === ' ') { event.preventDefault(); link.click(); }
      });
    }

    document.querySelectorAll<HTMLAnchorElement>('.learning-explainer-trigger').forEach(enhance);
    // showModal makes the page inert. Guards keep Tab inside the player while
    // preserving every keyboard stop in the browser's native media controls.
    dialog.querySelector('[data-focus-start]')?.addEventListener('focus', () => video.focus());
    dialog.querySelector('[data-focus-end]')?.addEventListener('focus', () => close.focus());
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      // Let the native Esc action close this dialog without declining the cookie banner.
      if (event.key === 'Escape') event.stopPropagation();
    });
    dialog.addEventListener('close', () => {
      video.pause();
      inlinePlayer.append(video);
      video.hidden = true;
      poster.hidden = false;
      document.documentElement.style.removeProperty('--explainer-scrollbar');
      trigger?.focus();
    });
  }
</script>

<style>
  .learning-explainer { display: grid; gap: var(--space-3); width: 100%; max-width: 880px; margin: 0 auto; }
  .explainer-inline { aspect-ratio: 16 / 9; }
  figcaption { text-align: center; }
  .explainer-poster { position: relative; display: block; aspect-ratio: 16 / 9; border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
  .explainer-poster[hidden] { display: none; }
  .explainer-poster img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .explainer-watch { position: absolute; left: 5%; bottom: 8%; display: flex; align-items: center; gap: var(--space-3); }
  .explainer-play { display: grid; place-items: center; width: 88px; height: 88px; border-radius: var(--radius-pill); background: var(--brand); color: var(--on-brand); box-shadow: 0 4px 16px color-mix(in srgb, var(--brand) 30%, transparent); transition: background-color 150ms, box-shadow 150ms; }
  .explainer-watch-label { padding: var(--space-2) var(--space-4); border: 1px solid var(--line); border-radius: var(--radius-pill); background: var(--bg); color: var(--ink); font-weight: 600; box-shadow: var(--shadow-card); }
  .explainer-poster:hover .explainer-play, .explainer-poster:focus-visible .explainer-play { background: var(--brand-hover); box-shadow: 0 4px 20px color-mix(in srgb, var(--brand) 45%, transparent); }
  .explainer-poster:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  dialog { width: min(960px, calc(100% - 32px)); max-width: none; max-height: calc(100dvh - 32px); margin: auto; padding: var(--space-4); border: 1px solid var(--line-strong); border-radius: var(--radius-lg); background: var(--bg); color: var(--ink); }
  dialog::backdrop { background: color-mix(in srgb, var(--code-bg) 75%, transparent); }
  .explainer-header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); }
  .explainer-player { aspect-ratio: 16 / 9; }
  .explainer-focus-guard { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  :global(html:has(#learning-explainer-dialog[open])) { overflow: hidden; padding-right: var(--explainer-scrollbar, 0px); }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: var(--surface); border-radius: var(--radius-md); }
  video[hidden] { display: none; }
  video:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  @media (max-width: 600px) {
    .explainer-play { width: 64px; height: 64px; }
    .explainer-play svg { width: 32px; height: 32px; }
    .explainer-watch-label { padding: var(--space-1) var(--space-3); font-size: 14px; }
    dialog { width: 100%; max-height: 100dvh; padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); border-radius: 0; }
    video::-webkit-media-controls-panel { min-height: 44px; }
    video::-webkit-media-controls-play-button,
    video::-webkit-media-controls-mute-button,
    video::-webkit-media-controls-fullscreen-button,
    video::-webkit-media-controls-toggle-closed-captions-button { min-width: 44px; min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .explainer-play { transition: none; }
  }
</style>
