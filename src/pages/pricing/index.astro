---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import { MONTHLY_PRICE_INR, MONTHLY_PRICE_USD, paidTracks } from '../../data/site';
import { offer } from '../../data/payment';
---

<Base
  title="Pricing"
  description="Rsquared Academy prepaid passes: 12 months or 1 month, all tracks, one-time payments and no automatic renewal."
  noindex
>
  <section class="sec page-head" aria-labelledby="pricing-h">
    <div class="wrap flex flex-col gap-5">
      <span class="eyebrow">Pricing</span>
      <h1 id="pricing-h" class="t-h1 max-w-[760px]">Two passes. Pay once, learn at your pace.</h1>
      <p class="t-lead max-w-[680px]">Choose a 12-month pass or a 1-month pass. Both cover all three paid tracks. Both are prepaid, one-time payments with no automatic renewal.</p>
      <div><Badge tone="soon">Paid tracks coming 2027</Badge></div>
    </div>
  </section>

  <section class="sec flush" aria-labelledby="plan-h">
    <div class="wrap">
      <div class="plan">
        <div class="flex flex-col gap-4 min-w-0">
          <h2 id="plan-h" class="t-h2">12-month pass — our main plan</h2>
          <p class="price">{offer.planPrice}</p>
          <p class="t-muted">One-time payment for {offer.accessMonths} months of access</p>
          <ul class="checklist">
            <li>All three paid tracks: Data Analyst with R, Data Analyst with Python and SQL for Data Analysts.</li>
            <li>Every lesson and exercise, with instant feedback in your browser.</li>
            <li>Updates released during your {offer.accessMonths} months.</li>
            <li>Email support.</li>
          </ul>
          <div><Button href="/#signup">Hear when the tracks open</Button></div>
        </div>
        <div class="flex flex-col gap-3 min-w-0 plan-note">
          <h3 class="t-h3">1-month pass</h3>
          <p class="t-h3">India: ₹{MONTHLY_PRICE_INR}<br />Outside India: US${MONTHLY_PRICE_USD}</p>
          <p class="t-muted">One-time payment for 1 month of the same access to all tracks, updates and email support. No automatic renewal.</p>
          <p class="t-muted">Both passes are available in India through Razorpay and outside India through our merchant of record.</p>
          <h3 class="t-h3">When you pay</h3>
          <p class="t-muted">Your first pass starts right after payment is confirmed. Buying again before your pass ends adds the new period after the current end date. No days are lost. There is no upgrade credit.</p>
          <p class="t-small t-muted">Prices and any applicable taxes are shown at checkout. See <a href="/delivery/">Delivery and access</a> and the <a href="/refund/">Refund and cancellation policy</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec bg-surface" aria-labelledby="founding-h">
    <div class="wrap flex flex-col gap-4">
      <h2 id="founding-h" class="t-h2">Founding offer</h2>
      <p class="t-muted max-w-[680px]">The founding offer is for the 12-month pass only, limited to {offer.foundingSeats} seats. The founding price is <strong>{offer.foundingPrice}</strong> for {offer.accessMonths} months of access to all tracks.</p>
      <p class="t-muted max-w-[680px]">Founding members keep their founding price for each 12-month renewal bought before the pass ends or within {offer.renewalWindowDays} days after it ends. After a longer gap, the list price applies.</p>
      <p class="t-muted max-w-[680px]">There is no automatic billing. A renewal is a new purchase.</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="tracks-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <h2 id="tracks-h" class="t-h2">Paid tracks</h2>
        <p class="t-muted">One business dataset, the ShopVibe online shop, runs through every course. You build the skills analysts use, in your browser, with instant feedback. All tracks are coming in 2027.</p>
      </div>
      <div class="three">
        {paidTracks.map((track) => (
          <article class="rsa-card" id={track.id}>
            <div class="rsa-card-badges"><Badge tone="soon">Coming 2027</Badge></div>
            <h3 class="rsa-card-title">{track.title}</h3>
            <p class="rsa-card-text">{track.summary}</p>
            <p class="t-small t-muted">{track.covers}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec flush" aria-labelledby="free-h">
    <div class="wrap">
      <div class="split bg-surface-tint rounded-lg p-10">
        <div class="flex flex-col gap-2 min-w-0">
          <h2 id="free-h" class="t-h2">Free to start</h2>
          <p class="t-muted">Introduction to R, Data Wrangling with dplyr and Data Viz with ggplot2 are free. They open in December 2026.</p>
          <p class="t-muted">Lessons 0–2 of every course are free to try before you buy.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <Button variant="secondary" href="/courses/">See the free courses</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="sec flush" aria-labelledby="know-h">
    <div class="wrap legal">
      <h2 id="know-h" class="t-h2">What to know</h2>
      <ul>
        <li>We email before your pass ends: 30 and 7 days before for a 12-month pass; 5 and 1 days before for a 1-month pass.</li>
        <li>Your progress is kept after your pass ends. Free courses and free lessons stay free. See <a href="/delivery/">Delivery and access</a>.</li>
        <li>12-month pass: a full refund within 14 days of purchase if you have completed less than 20% of the lessons in every paid track (no single track at 20% or more).</li>
        <li>1-month pass: no refunds, except a duplicate charge or a technical problem we can't fix. See the <a href="/refund/">Refund and cancellation policy</a>.</li>
        <li>We never see your card details. See <a href="/privacy/">Privacy</a>.</li>
        <li>Questions about an order or a track? See <a href="/contact/">Contact</a> or <a href="/support/">Support</a>.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: 96px;
    padding-bottom: 64px;
  }
  .plan {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-12);
    align-items: start;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }
  .price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 54px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .checklist {
    margin: 0;
    padding-left: 24px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink-muted);
  }
  .plan-note {
    border-left: 1px solid var(--line);
    padding-left: var(--space-8);
  }
  .three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .legal {
    max-width: var(--text-max);
  }
  .legal ul {
    margin: 0;
    padding-left: 24px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .flush {
    padding-top: 0;
  }
  @media (max-width: 860px) {
    .page-head {
      padding-block: var(--space-12);
    }
    .plan,
    .three,
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan-note {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: var(--space-6);
    }
    .price {
      font-size: 38px;
      line-height: 42px;
    }
  }
</style>
