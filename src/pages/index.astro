---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import LearningLadder from '../components/LearningLadder.astro';
import LearningExplainer from '../components/LearningExplainer.astro';
import LearningExplainerTrigger from '../components/LearningExplainerTrigger.astro';
import TrustSignals from '../components/TrustSignals.astro';
import SignupBand from '../components/SignupBand.astro';
import { courses, links, startLessonHref, startLessonLabel } from '../data/site';
import Illustration from '../components/home/Illustration.astro';
import Courses from '../components/home/Courses.astro';
import Inside from '../components/home/Inside.astro';
import HeroLoop from '../components/home/HeroLoop.astro';
import '../styles/home.css';
const resources = [
  { title: 'eBooks', text: 'Free online books on R, from your first lines of code to wrangling and plotting.', action: 'Read the eBooks', href: links.ebooks },
  { title: 'Open courses', text: 'Free course material for learning R, to read at your own pace. Open source on GitHub.', action: 'Read the open courses', href: links.openCourses },
  { title: 'Blog', text: 'Tutorials and worked examples of data analysis in R.', action: 'Read the blog', href: links.blog },
  { title: 'YouTube', text: 'Short videos that walk through R code step by step.', action: 'Watch on YouTube', href: links.youtube },
];
---
<Base title="Rsquared Academy" description="Interactive courses in R, Python and SQL for data analysis, with instant feedback. Nothing to install.">
  <div class="home">
    <section class="home-hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="hero-copy">
          <p class="eyebrow">Free hands-on data courses <span aria-hidden="true">·</span> R, Python and SQL</p>
          <h1 id="hero-h">Learn data analysis by doing, in your browser.</h1>
          <p class="t-lead">Work with realistic data in short courses using R, Python and SQL. Write code, see the result and get feedback as you go. Nothing to install.</p>
          <div class="hero-actions"><Button href={startLessonHref(courses[0], 'hero')}>{startLessonLabel}</Button><LearningExplainerTrigger /></div>
          <p class="hero-note t-small t-muted">Free to start <span aria-hidden="true">·</span> no account needed <span aria-hidden="true">·</span> progress saved in this browser</p>
        </div>
        <HeroLoop />
      </div>
    </section>

    <Inside />
    <Courses />

    <section class="home-section teaching-section" aria-labelledby="how-h">
      <div class="wrap">
        <div class="teaching-intro">
          <div class="teaching-copy"><p class="eyebrow">How it works</p><h2 id="how-h" class="t-h2">A little reading.<br />A lot of doing.</h2><p class="t-lead">Read a short lesson, write code in your browser and get instant feedback.</p><p class="t-muted">Each idea comes with a small, realistic dataset, explained in plain words. Find out straight away whether your answer is right, and what to fix if it isn't.</p></div>
          <div class="teaching-art"><Illustration name="learning-steps" /></div>
        </div>
        <div class="ladder-heading"><h2 id="ladder-h" class="t-h2">How you'll learn</h2><p class="t-muted">Each lesson takes one idea and climbs four steps, from watching it done to doing it yourself.</p></div>
        <div class="learning-content" aria-labelledby="ladder-h"><LearningExplainer /><LearningLadder aligned /></div>
        <div class="teaching-footer"><Button variant="text" href="/how-we-teach/">How we teach <span aria-hidden="true">↗</span></Button><p class="t-small t-muted">It runs in any modern browser and works best on a tablet, laptop or desktop.</p></div>
      </div>
    </section>

    <TrustSignals />

    <section class="home-section resources-section" aria-labelledby="free-h">
      <div class="wrap">
        <div class="resources-heading"><div><p class="eyebrow">Keep learning</p><h2 id="free-h" class="t-h2">Free resources</h2><p class="t-lead">Read, watch and practise at your own pace.</p></div><div class="resource-art"><Illustration name="free-resources" /></div></div>
        <div class="home-resource-grid">
          {resources.map((resource) => <a class="home-resource-card" href={resource.href}><h3 class="t-h3">{resource.title}</h3><p class="t-muted">{resource.text}</p><span class="resource-action">{resource.action} <span aria-hidden="true">↗</span></span></a>)}
        </div>
      </div>
    </section>

    <section class="home-section next-section" aria-labelledby="next-h">
      <div class="wrap next-layout">
        <div class="next-art"><Illustration name="learning-roadmap" /></div>
        <div class="next-copy"><Badge tone="soon">Coming 2027</Badge><h2 id="next-h" class="t-h2">Paid tracks coming in 2027</h2><p class="t-muted">Data Analyst with R, Data Analyst with Python and SQL for Data Analysts. Each track builds on one realistic business dataset. See the <a href="/courses/#paid-h">full descriptions</a>.</p><div><Button variant="secondary" href="#signup">Hear when they open</Button></div></div>
      </div>
    </section>
    <section class="home-section signup-section" aria-label="Course updates"><div class="wrap"><SignupBand id="home-email" site="www.rsquaredacademy.com" /></div></section>
  </div>
</Base>
