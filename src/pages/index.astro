---
// Home page.
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import ConsoleSnippet from '../components/ConsoleSnippet.astro';
import CourseCard from '../components/CourseCard.astro';
import SignupBand from '../components/SignupBand.astro';
import { courses, foundationsBadges, links } from '../data/site';

// Hero R console: real R with its true output.
const heroCode = [
  { input: 'sales <- c(120, 95, 143, 110)' },
  { input: 'mean(sales)' },
  { output: '[1] 117' },
  { input: 'max(sales) - min(sales)' },
  { output: '[1] 48' },
];
---

<Base
  title="Rsquared Academy"
  description="Free interactive courses with instant feedback. Nothing to install."
>
  <!-- Hero -->
  <section class="sec hero-sec">
    <div class="wrap hero-grid">
      <div class="flex flex-col gap-6 min-w-0">
        <div class="flex gap-2 flex-wrap">
          <Badge tone="free">Free courses</Badge>
          <Badge tone="soon">First courses launching Dec 2026</Badge>
        </div>
        <h1 class="t-display max-w-[640px]">Learn R for data analysis, in your browser.</h1>
        <p class="t-lead max-w-[560px]">Free interactive courses with instant feedback. Nothing to install.</p>
        <div class="flex gap-3 flex-wrap">
          <Button href="#signup">Get updates</Button>
          <Button variant="secondary" href="#courses">See the courses</Button>
        </div>
      </div>
      <div class="flex flex-col gap-3 min-w-0">
        <ConsoleSnippet lines={heroCode} label="An R console example" />
        <p class="t-small t-muted">Real R, written and run in the lesson. No setup, nothing to download.</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="sec bg-surface" aria-labelledby="how">
    <div class="wrap flex flex-col gap-8">
      <h2 id="how" class="t-h2">How it works</h2>
      <ol class="three list-none m-0 p-0">
        <li class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <span class="step-num">1</span>
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-muted"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"></path></svg>
          </div>
          <h3 class="t-h3">Read a short lesson</h3>
          <p class="t-muted">Each idea comes with a small, real dataset, explained in plain words.</p>
        </li>
        <li class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <span class="step-num">2</span>
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-muted"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
          </div>
          <h3 class="t-h3">Write R in your browser</h3>
          <p class="t-muted">Type code into the lesson and run it. There is nothing to install.</p>
        </li>
        <li class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <span class="step-num">3</span>
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-muted"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
          </div>
          <h3 class="t-h3">Get instant feedback</h3>
          <p class="t-muted">Find out straight away whether your answer is right, and what to fix if it isn't.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Courses -->
  <section class="sec" id="courses" aria-labelledby="courses-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[640px]">
        <span class="eyebrow">Foundations</span>
        <h2 id="courses-h" class="t-h2">Three free courses to start with</h2>
        <p class="t-lead">We're rebuilding our courses and learning platform from scratch, so you can learn R in your browser with instant feedback. The first three free courses open in December 2026.</p>
      </div>
      <div class="three rsa-card-grid">
        {courses.map((course) => (
          <CourseCard eyebrow={course.eyebrow} title={course.title} description={course.short} badges={foundationsBadges} />
        ))}
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="sec bg-surface" aria-labelledby="trust">
    <div class="wrap trust-grid">
      <div class="flex flex-col gap-4 min-w-0">
        <h2 id="trust" class="t-h2">From the team behind the R packages olsrr, descriptr and rfm</h2>
        <p class="t-muted max-w-[560px]">The courses are built from our free eBooks, so you can read ahead or look back at any time.</p>
        <div><Button variant="text" href="/open-source/">See our open-source work</Button></div>
      </div>
      <div class="flex flex-col gap-3 bg-bg border border-line rounded-lg p-8 min-w-0">
        <p class="stat">Our open-source R packages have been downloaded more than 2.8 million times.</p>
        <p class="t-small t-muted">Source: downloads from the Posit CRAN mirror (cranlogs), October 2026. Other mirrors are not counted.</p>
      </div>
    </div>
  </section>

  <!-- Free resources -->
  <section class="sec" aria-labelledby="free">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[640px]">
        <h2 id="free" class="t-h2">Free resources</h2>
        <p class="t-lead">Read, watch and practise at your own pace.</p>
      </div>
      <div class="four res-grid">
        <a href={links.ebooks} class="res-card p-6 border border-line rounded-lg text-ink no-underline">
          <span class="res-head"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"></path><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"></path></svg><span class="t-h3">eBooks</span></span>
          <span class="t-muted">Free online books on R, from your first lines of code to wrangling and plotting.</span>
          <span class="mt-2 font-semibold text-link">Read the eBooks</span>
        </a>
        <a href={links.openCourses} class="res-card p-6 border border-line rounded-lg text-ink no-underline">
          <span class="res-head"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M22 10 12 5 2 10l10 5 10-5z"></path><path d="M6 12v5c3 2 9 2 12 0v-5"></path></svg><span class="t-h3">Open courses</span></span>
          <span class="t-muted">Free course material for learning R, to read at your own pace. Open source on GitHub.</span>
          <span class="mt-2 font-semibold text-link">Read the open courses</span>
        </a>
        <a href={links.blog} class="res-card p-6 border border-line rounded-lg text-ink no-underline">
          <span class="res-head"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg><span class="t-h3">Blog</span></span>
          <span class="t-muted">Tutorials and worked examples of data analysis in R.</span>
          <span class="mt-2 font-semibold text-link">Read the blog</span>
        </a>
        <a href={links.youtube} class="res-card p-6 border border-line rounded-lg text-ink no-underline">
          <span class="res-head"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><rect x="2" y="5" width="20" height="14" rx="3"></rect><polygon points="10 9 15 12 10 15 10 9"></polygon></svg><span class="t-h3">YouTube</span></span>
          <span class="t-muted">Short videos that walk through R code step by step.</span>
          <span class="mt-2 font-semibold text-link">Watch on YouTube</span>
        </a>
      </div>
    </div>
  </section>

  <!-- The Data Analyst track -->
  <section class="sec flush" aria-labelledby="next">
    <div class="wrap">
      <div class="flex flex-wrap gap-6 items-center justify-between p-8 border border-line rounded-lg">
        <div class="flex flex-col gap-2 flex-[1_1_480px] min-w-0">
          <div><Badge tone="soon">Coming 2027</Badge></div>
          <h2 id="next" class="t-h2">The Data Analyst track</h2>
          <p class="t-muted max-w-[600px]">A longer path after the Foundations, built around one realistic business dataset, with SQL and customer analytics.</p>
        </div>
        <Button variant="secondary" href="#signup">Hear when it opens</Button>
      </div>
    </div>
  </section>

  <!-- Sign up -->
  <section class="sec flush">
    <div class="wrap">
      <SignupBand id="home-email" site="www.rsquaredacademy.com" />
    </div>
  </section>
</Base>

<style>
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-12); align-items: center; }
  .trust-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-12); align-items: start; }
  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .four { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); }
  /* Resource cards: icon + name, description and link rows line up across a row of cards */
  .res-grid > .res-card { display: grid; grid-template-rows: subgrid; grid-row: span 3; row-gap: var(--space-2); align-content: start; }
  .res-head { display: flex; align-items: center; gap: var(--space-3); }
  .res-head svg { flex: none; }
  .hero-sec { padding-top: 96px; }
  .flush { padding-top: 0; }
  .step-num { display: inline-flex; width: 36px; height: 36px; border-radius: var(--radius-pill); background: var(--brand); color: var(--on-brand); align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; }
  .stat { margin: 0; font-family: var(--font-display); font-size: 30px; line-height: 38px; font-weight: 700; letter-spacing: -0.01em; text-wrap: balance; }
  @media (max-width: 1100px) {
    .four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .hero-grid, .trust-grid { grid-template-columns: minmax(0, 1fr); }
    .three { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .four { grid-template-columns: minmax(0, 1fr); }
  }
</style>
