---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Thanks" description="Thanks for getting in touch with Rsquared Academy.">
  <section class="sec">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 20px;">
      <h1 class="t-h1">Thanks</h1>
      <p class="t-lead">We've got your details. We'll be in touch by email.</p>
      <div><Button variant="secondary" href="/">Back to the home page</Button></div>
    </div>
  </section>
</Base>
