---
// Open source page.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ConsoleSnippet from '../../components/ConsoleSnippet.astro';
import { links } from '../../data/site';
import { packageGroups, shinyApps, appCode } from '../../data/packages';
---

<Base
  title="Open source"
  description="Free on CRAN, with the code on GitHub."
>
  <section class="sec sec-hero">
    <div class="wrap flex flex-col gap-5">
      <span class="eyebrow">Open source</span>
      <h1 class="t-h1 max-w-[780px]">Open-source R packages for everyday analysis</h1>
      <p class="t-lead max-w-[680px]">Free on CRAN, with the code on GitHub. Each package has its own documentation site with examples.</p>
      <div class="flex gap-3 flex-wrap">
        <Button href="https://pkgs.rsquaredacademy.com/">Browse all packages</Button>
        <Button variant="secondary" href={links.github}>rsquaredacademy on GitHub</Button>
      </div>
    </div>
  </section>

  <section class="sec sec-flush" aria-labelledby="pk-h">
    <div class="wrap flex flex-col gap-10">
      <h2 id="pk-h" class="t-h2">R packages</h2>
      {packageGroups.map((g) => (
        <div class="flex flex-col gap-4">
          <h3 class="eyebrow">{g.title}</h3>
          <div class="lgrid">
            {g.pkgs.map((p) => (
              <article class="lc">
                <div class="lside">
                  <img class="lhex" src={p.hex} alt="" width="86" height="100" loading="lazy" />
                </div>
                <div class="lbody">
                  <h4 class="ltitle"><a href={p.docs}>{p.name}</a></h4>
                  <p class="lout">{p.out}</p>
                  <p class="ldesc">{p.desc}</p>
                  <details class="ldet">
                    <summary>What's inside</summary>
                    <ul>
                      {p.inside.map((it) => <li>{it}</li>)}
                    </ul>
                  </details>
                  <div class="lactions">
                    <a class="lbtn primary" href={p.docs} aria-label={`${p.name} documentation`}>Docs</a>
                    <a class="lbtn" href={p.cran} aria-label={`${p.name} on CRAN`}>CRAN</a>
                    <a class="lbtn" href={p.gh} aria-label={`${p.name} on GitHub`}>GitHub</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec bg-surface" aria-labelledby="apps-h">
    <div class="wrap split">
      <div class="flex flex-col gap-6 min-w-0">
        <div class="flex flex-col gap-2">
          <h2 id="apps-h" class="t-h2">Shiny apps</h2>
          <p class="t-muted max-w-[600px]">Point-and-click apps for exploring data, built on our packages. They come with xplorerr and run on your own computer.</p>
        </div>
        <div class="tbl-box">
          <table class="tbl">
            <thead><tr><th scope="col">App</th><th scope="col">Run it</th></tr></thead>
            <tbody>
              {shinyApps.map((a) => (
                <tr><td>{a.what}</td><td><code>{a.fn}</code></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="flex flex-col gap-3 min-w-0">
        <h3 class="t-h3">Try one in R</h3>
        <ConsoleSnippet lines={appCode} label="Install xplorerr and open the linear regression app" />
        <div><Button variant="text" href="https://xplorerr.rsquaredacademy.com/">xplorerr documentation</Button></div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="mat-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <h2 id="mat-h" class="t-h2">Open learning material</h2>
        <p class="t-muted">Our eBooks and open course material are on GitHub too.</p>
      </div>
      <div class="three">
        <a class="tile" href={links.openCourses}>
          <span class="t-h3">Open courses</span>
          <span class="text-ink-muted">Free course material for learning R, to read at your own pace.</span>
          <span class="mt-auto font-semibold text-link">Read the open courses</span>
        </a>
        <a class="tile" href={links.openCoursesRepo}>
          <span class="t-h3">Open courses source</span>
          <span class="text-ink-muted">The source of the open course material.</span>
          <span class="mt-auto font-semibold text-link">See it on GitHub</span>
        </a>
        <a class="tile" href="https://github.com/rsquaredacademy-publications">
          <span class="t-h3">eBook sources</span>
          <span class="text-ink-muted">The source of every eBook, from Introduction to R to R, Databases & SQL.</span>
          <span class="mt-auto font-semibold text-link">See them on GitHub</span>
        </a>
      </div>
    </div>
  </section>

  <section class="sec sec-flush" aria-labelledby="help-h">
    <div class="wrap">
      <div class="flex flex-wrap gap-6 items-center justify-between p-8 border border-line rounded-lg">
        <div class="flex flex-col gap-2 grow basis-[480px] min-w-0">
          <h2 id="help-h" class="t-h2">Found a bug or have an idea?</h2>
          <p class="t-muted">Open an issue on the package's GitHub repository. Pull requests are welcome.</p>
        </div>
        <Button variant="secondary" href={links.github}>Go to GitHub</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Section padding overrides. */
  .sec-hero { padding-top: 96px; padding-bottom: 64px; }
  .sec-flush { padding-top: 0; }

  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .split { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-12); align-items: start; }
  .lgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); row-gap: 0; }
  .lc { display: grid; grid-template-columns: 86px minmax(0, 1fr); grid-row: span 5; grid-template-rows: subgrid; column-gap: 20px; row-gap: 10px; margin-bottom: var(--space-6); padding: 20px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); min-width: 0; }
  .lside { grid-column: 1; grid-row: 1 / -1; align-self: start; }
  .lhex { display: block; width: 86px; height: 100px; }
  .lactions { display: flex; flex-wrap: wrap; gap: 8px; align-self: end; }
  .lbtn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; box-sizing: border-box; padding: 6px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font: 600 15px/20px var(--font-body); color: var(--ink); background: var(--bg); text-decoration: none; text-align: center; }
  .lbtn:hover { border-color: var(--ink); color: var(--ink); }
  .lbtn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .lbtn.primary { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
  .lbtn.primary:hover { background: var(--brand-hover); border-color: var(--brand-hover); color: var(--on-brand); }
  .lbody { display: contents; }
  .lbody > * { grid-column: 2; min-width: 0; }
  .lbody > .ldet { align-self: start; }
  .ltitle { margin: 0; font-family: var(--font-mono); font-size: 22px; line-height: 30px; font-weight: 500; }
  .ltitle a { color: var(--ink); text-decoration: none; }
  .ltitle a:hover { color: var(--brand); }
  .lout { margin: 0; font-size: 17px; line-height: 26px; font-weight: 600; }
  .ldesc { margin: 0; color: var(--ink-muted); font-size: 16px; line-height: 24px; }
  .ldet { font-size: 15px; line-height: 22px; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 10px 12px; }
  .ldet summary { cursor: pointer; font-weight: 600; }
  .ldet summary:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .ldet ul { margin: 8px 0 2px 18px; padding: 0; max-height: 200px; overflow: auto; color: var(--ink-muted); }
  .tile { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); color: var(--ink); text-decoration: none; min-width: 0; }
  .tile:hover { border-color: var(--line-strong); box-shadow: var(--shadow-card); color: var(--brand-hover); }
  .tile:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .tbl-box { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); }
  .tbl { width: 100%; border-collapse: collapse; font-size: 16px; line-height: 24px; min-width: 520px; }
  .tbl th { text-align: left; font-weight: 600; font-size: 13px; line-height: 16px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); padding: 14px 20px; border-bottom: 1px solid var(--line); }
  .tbl td { padding: 14px 20px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tbl tr:last-child td { border-bottom: 0; }
  .tbl code { font-family: var(--font-mono); font-size: 15px; }

  @media (max-width: 1100px) { .three { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 980px) { .lgrid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 860px) { .split { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .three { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 420px) {
    .lc { padding: 16px; grid-template-columns: 72px minmax(0, 1fr); column-gap: 14px; }
    .lhex { width: 72px; height: 84px; }
  }
  /* Touch screens: 44px tap targets without shifting the layout */
  @media (pointer: coarse) {
    .ldet summary { padding-block: 11px; }
    .ltitle a { display: inline-block; padding-block: 8px; margin-block: -8px; }
  }
</style>
