---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="sec">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 20px;">
      <h1 class="t-h1">Page not found</h1>
      <p class="t-lead">This page doesn't exist, or it moved when we rebuilt the site.</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <Button href="/">Go to the home page</Button>
        <Button variant="secondary" href="/courses/">See the courses</Button>
      </div>
    </div>
  </section>
</Base>
