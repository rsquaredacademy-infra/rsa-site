---
// Courses page.
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import CourseCard from '../../components/CourseCard.astro';
import { courses, foundationsBadges, links, paidTracks } from '../../data/site';
import { passes } from '../../data/payment';
---

<Base
  title="Courses"
  description="We're rebuilding our courses and learning platform from scratch, so you can learn R, Python and SQL in your browser with instant feedback."
>
  <!-- Page header -->
  <section class="sec page-sec">
    <div class="wrap flex flex-col gap-5">
      <span class="eyebrow">Courses</span>
      <h1 class="t-h1 max-w-[760px]">Interactive courses in R, Python and SQL for data analysis</h1>
      <p class="t-lead max-w-[680px]">We're rebuilding our courses and learning platform from scratch, so you can learn R, Python and SQL in your browser with instant feedback. Start with three free Foundations courses in R, opening in December 2026.</p>
    </div>
  </section>

  <!-- Foundations -->
  <section class="sec flush" aria-labelledby="found-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-wrap gap-4 items-end justify-between">
        <div class="flex flex-col gap-2 max-w-[640px]">
          <div class="flex gap-2 flex-wrap">
            <Badge tone="free">Free</Badge>
          </div>
          <h2 id="found-h" class="t-h2">Foundations</h2>
          <p class="t-muted">Three short courses that take you from your first line of R to clean data and clear charts. Take them in order, or start where you need to.</p>
        </div>
      </div>
      <div class="three rsa-card-grid">
        {courses.map((course) => (
          <CourseCard eyebrow={course.eyebrow} title={course.title} description={course.long} badges={foundationsBadges} href={course.href} />
        ))}
      </div>
      <p class="t-muted">Free Intro to SQL and Intro to Python courses are coming soon.</p>
    </div>
  </section>

  <!-- What's inside -->
  <section class="sec bg-surface" aria-labelledby="every-h">
    <div class="wrap flex flex-col gap-8">
      <h2 id="every-h" class="t-h2">What's inside</h2>
      <ul class="inside-grid list-none m-0 p-0">
        <li class="inside-item">
          <div class="inside-head">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <h3 class="t-h3">R in your browser</h3>
          </div>
          <p class="t-muted">Write and run code in the lesson. Nothing to install.</p>
        </li>
        <li class="inside-item">
          <div class="inside-head">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path><path d="m15 5 4 4"></path></svg>
            <h3 class="t-h3">Practice by doing</h3>
          </div>
          <p class="t-muted">Worked example, then fill in, fix and write your own code.</p>
        </li>
        <li class="inside-item">
          <div class="inside-head">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
            <h3 class="t-h3">Feedback and hints</h3>
          </div>
          <p class="t-muted">Instant feedback on every answer, with a hint when you're stuck.</p>
        </li>
        <li class="inside-item">
          <div class="inside-head">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><rect width="8" height="8" x="3" y="3" rx="1"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="1"></rect></svg>
            <h3 class="t-h3">Step-through diagrams</h3>
          </div>
          <p class="t-muted">Watch each dplyr step change the data. Coming with the dplyr course.</p>
        </li>
        <li class="inside-item">
          <div class="inside-head">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14a9 3 0 0 0 18 0V5"></path><path d="M3 12a9 3 0 0 0 18 0"></path></svg>
            <h3 class="t-h3">Datasets panel</h3>
          </div>
          <p class="t-muted">Open the data beside your code and check it as you work.</p>
        </li>
        <li class="inside-item">
          <div class="inside-head">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
            <h3 class="t-h3">Report a problem</h3>
          </div>
          <p class="t-muted">Use the link in any lesson to tell us what needs fixing.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Paid tracks -->
  <section class="sec" aria-labelledby="paid-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <div><Badge tone="soon">Coming 2027</Badge></div>
        <h2 id="paid-h" class="t-h2">Paid tracks (coming 2027)</h2>
        <p class="t-muted">Choose a {passes.annual.exact} or a {passes.monthly.exact}. Both cover all three tracks, with one-time payments and no automatic renewal. One business dataset, the ShopVibe online shop, runs through every course. You build the skills analysts use, in your browser, with instant feedback.</p>
      </div>
      <div class="three rsa-card-grid rsa-card-grid--tracks">
        {paidTracks.map((track) => (
          <article class="rsa-card" id={track.id}>
            <div class="rsa-card-badges"><Badge tone="soon">Coming 2027</Badge></div>
            <h3 class="rsa-card-title">{track.title}</h3>
            <p class="rsa-card-text">{track.summary}</p>
            <ul class="t-small t-muted track-list">
              {track.curriculum.map((course) => <li>{course}</li>)}
            </ul>
            <p class="t-small t-muted track-note">{track.note}</p>
          </article>
        ))}
      </div>
      <div>
        <Button variant="secondary" href="/#signup">Hear when the tracks open</Button>
      </div>
    </div>
  </section>

  <!-- Current courses -->
  <section class="sec flush" aria-labelledby="current-h">
    <div class="wrap">
      <div class="bg-surface rounded-lg p-10 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col gap-2 min-w-0">
          <h2 id="current-h" class="t-h2">Looking for our current courses?</h2>
          <p class="t-muted">Our current courses stay open on Thinkific while we move each one to the new platform.</p>
        </div>
        <div class="flex sm:flex-none">
          <Button variant="secondary" href={links.thinkific} class="w-full whitespace-nowrap sm:w-auto">Go to the current courses</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Sign-up CTA -->
  <section class="sec flush" aria-labelledby="cta-h">
    <div class="wrap">
      <div class="flex flex-wrap gap-6 items-center justify-between bg-surface-tint rounded-lg p-10">
        <div class="flex flex-col gap-2 flex-[1_1_420px] min-w-0">
          <h2 id="cta-h" class="t-h2">Hear when the free courses open</h2>
          <p class="t-muted">We'll email you when Introduction to R opens in December 2026.</p>
        </div>
        <Button href="/#signup">Get updates</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-sec { padding-top: 96px; padding-bottom: 64px; }
  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .track-list { margin: 0; padding-left: 20px; list-style: disc; display: flex; flex-direction: column; gap: 4px; }
  .inside-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); row-gap: var(--space-8); }
  .inside-item { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .inside-head { display: flex; align-items: center; gap: var(--space-3); }
  .inside-head svg { flex: none; }
  .flush { padding-top: 0; }
  @media (max-width: 860px) {
    .three { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .inside-grid { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
  }
</style>
