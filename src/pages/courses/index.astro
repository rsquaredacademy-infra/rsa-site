---
// Courses page.
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import CourseCard from '../../components/CourseCard.astro';
import { courses, foundationsBadges, links, paidTracks } from '../../data/site';
---

<Base
  title="Courses"
  description="We're rebuilding our courses and learning platform from scratch, so you can learn R in your browser with instant feedback."
>
  <!-- Page header -->
  <section class="sec page-sec">
    <div class="wrap flex flex-col gap-5">
      <span class="eyebrow">Courses</span>
      <h1 class="t-h1 max-w-[760px]">Interactive R courses for data analysis</h1>
      <p class="t-lead max-w-[680px]">We're rebuilding our courses and learning platform from scratch, so you can learn R in your browser with instant feedback. Start with three free Foundations courses, opening in December 2026.</p>
    </div>
  </section>

  <!-- Foundations -->
  <section class="sec flush" aria-labelledby="found-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-wrap gap-4 items-end justify-between">
        <div class="flex flex-col gap-2 max-w-[640px]">
          <div class="flex gap-2 flex-wrap">
            <Badge tone="free">Free</Badge>
          </div>
          <h2 id="found-h" class="t-h2">Foundations</h2>
          <p class="t-muted">Three short courses that take you from your first line of R to clean data and clear charts. Take them in order, or start where you need to.</p>
        </div>
      </div>
      <div class="three rsa-card-grid">
        {courses.map((course) => (
          <CourseCard eyebrow={course.eyebrow} title={course.title} description={course.long} badges={foundationsBadges} href={course.href} />
        ))}
      </div>
      <p class="t-muted">Free Intro to SQL and Intro to Python courses are coming soon.</p>
    </div>
  </section>

  <!-- What's inside -->
  <section class="sec bg-surface" aria-labelledby="every-h">
    <div class="wrap flex flex-col gap-8">
      <h2 id="every-h" class="t-h2">What's inside</h2>
      <ul class="four list-none m-0 p-0">
        <li class="flex flex-col gap-2">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"></path></svg>
          <h3 class="t-h3">Short lessons</h3>
          <p class="t-muted">One idea at a time, with small, real datasets.</p>
        </li>
        <li class="flex flex-col gap-2">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
          <h3 class="t-h3">R in your browser</h3>
          <p class="t-muted">Write and run code in the lesson. Nothing to install.</p>
        </li>
        <li class="flex flex-col gap-2">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
          <h3 class="t-h3">Instant feedback</h3>
          <p class="t-muted">See straight away whether your answer is right, and what to fix.</p>
        </li>
        <li class="flex flex-col gap-2">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"></path><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"></path></svg>
          <h3 class="t-h3">A free eBook to go with it</h3>
          <p class="t-muted">Read ahead or look back at any time.</p>
        </li>
      </ul>
      <ul class="four list-none m-0 p-0">
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">Printed tables</h3>
          <p class="t-muted">Printed tables in the console keep their columns aligned so you can read each row.</p>
        </li>
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">Datasets panel</h3>
          <p class="t-muted">Open the datasets panel to look at the data while you code.</p>
        </li>
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">A console that fits</h3>
          <p class="t-muted">The console fits its pane, with scrolling for wide tables and long output.</p>
        </li>
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">Step-through diagrams <Badge tone="soon">Coming soon</Badge></h3>
          <p class="t-muted">Animated step-through diagrams showing how dplyr functions act on rows are coming with the dplyr course.</p>
        </li>
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">A hint when you need it</h3>
          <p class="t-muted">After a wrong answer, use the hint button for a nudge towards your next attempt.</p>
        </li>
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">Key-idea boxes <Badge tone="soon">Coming soon</Badge></h3>
          <p class="t-muted">Key-idea boxes that draw out a lesson's main point are coming soon.</p>
        </li>
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">Report a problem</h3>
          <p class="t-muted">Every lesson has a "Report a problem" link so you can tell us where something needs fixing.</p>
        </li>
        <li class="flex flex-col gap-2">
          <h3 class="t-h3">Our video player <Badge tone="soon">Coming soon</Badge></h3>
          <p class="t-muted">Short lesson videos in our own player are coming soon.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Paid tracks -->
  <section class="sec" aria-labelledby="paid-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <div><Badge tone="soon">Coming 2027</Badge></div>
        <h2 id="paid-h" class="t-h2">Paid tracks (coming 2027)</h2>
        <p class="t-muted">Choose a 12-month pass or a 1-month pass. Both cover all three tracks, with one-time payments and no automatic renewal. One business dataset, the ShopVibe online shop, runs through every course. You build the skills analysts use, in your browser, with instant feedback.</p>
      </div>
      <div class="three">
        {paidTracks.map((track) => (
          <article class="rsa-card" id={track.id}>
            <div class="rsa-card-badges"><Badge tone="soon">Coming 2027</Badge></div>
            <h3 class="rsa-card-title">{track.title}</h3>
            <p class="rsa-card-text">{track.summary}</p>
            <p class="t-small t-muted">{track.covers}</p>
          </article>
        ))}
      </div>
      <div>
        <Button variant="secondary" href="/#signup">Hear when the tracks open</Button>
      </div>
    </div>
  </section>

  <!-- Current courses -->
  <section class="sec flush" aria-labelledby="current-h">
    <div class="wrap">
      <div class="split bg-surface rounded-lg p-10">
        <div class="flex flex-col gap-2 min-w-0">
          <h2 id="current-h" class="t-h2">Looking for our current courses?</h2>
          <p class="t-muted">Our current courses stay open on Thinkific while we move each one to the new platform.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <Button variant="secondary" href={links.thinkific}>Go to the current courses</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Sign-up CTA -->
  <section class="sec flush" aria-labelledby="cta-h">
    <div class="wrap">
      <div class="flex flex-wrap gap-6 items-center justify-between bg-surface-tint rounded-lg p-10">
        <div class="flex flex-col gap-2 flex-[1_1_420px] min-w-0">
          <h2 id="cta-h" class="t-h2">Hear when the free courses open</h2>
          <p class="t-muted">We'll email you when Introduction to R opens in December 2026.</p>
        </div>
        <Button href="/#signup">Get updates</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-sec { padding-top: 96px; padding-bottom: 64px; }
  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .four { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-12); align-items: center; }
  .flush { padding-top: 0; }
  @media (max-width: 860px) {
    .three, .split { grid-template-columns: minmax(0, 1fr); }
    .four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .four { grid-template-columns: minmax(0, 1fr); }
  }
</style>
