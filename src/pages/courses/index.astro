---
// Courses page.
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import CourseCard from '../../components/CourseCard.astro';
import LearningLadder from '../../components/LearningLadder.astro';
import { courses, foundationsBadges, lessonTiles, paidTracks, startLessonHref } from '../../data/site';
import { passes } from '../../data/payment';
---

<Base
  title="Courses"
  description="We're rebuilding our courses and learning platform from scratch, so you can learn R, Python and SQL in your browser with instant feedback."
>
  <!-- Page header -->
  <section class="sec page-sec">
    <div class="wrap flex flex-col gap-5">
      <span class="eyebrow">Courses</span>
      <h1 class="t-h1 max-w-[760px]">Interactive courses in R, Python and SQL for data analysis</h1>
      <p class="t-lead max-w-[680px]">We're rebuilding our courses and learning platform from scratch, so you can learn R, Python and SQL in your browser with instant feedback. Start with three free Foundations courses in R, opening soon.</p>
    </div>
  </section>

  <!-- Foundations -->
  <section class="sec flush" aria-labelledby="found-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-wrap gap-4 items-end justify-between">
        <div class="flex flex-col gap-2 max-w-[640px]">
          <div class="flex gap-2 flex-wrap">
            <Badge tone="free">Free</Badge>
          </div>
          <h2 id="found-h" class="t-h2">Foundations</h2>
          <p class="t-muted">Three short courses that take you from your first line of R to clean data and clear charts. Take them in order, or start where you need to.</p>
        </div>
      </div>
      <div class="three rsa-card-grid">
        {courses.map((course) => (
          <CourseCard eyebrow={course.eyebrow} title={course.title} description={course.long} badges={foundationsBadges} href={course.href} visual={course.visual} startLessonHref={startLessonHref(course, `course-${course.id}`)} />
        ))}
      </div>
      <p class="t-muted">Free Intro to SQL and Intro to Python courses are coming soon.</p>
    </div>
  </section>

  <!-- How you'll learn -->
  <section class="sec flush" aria-labelledby="ladder-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <h2 id="ladder-h" class="t-h2">How you'll learn</h2>
        <p class="t-muted">Lessons in the Foundations courses follow the same four steps. When you get stuck, hints appear one at a time and feedback says what to look at, without giving the answer away.</p>
      </div>
      <LearningLadder />
      <div><Button variant="text" href="/how-we-teach/">How we teach</Button></div>
    </div>
  </section>

    <!-- See how a lesson works -->
  <section class="sec bg-surface" aria-labelledby="how-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <h2 id="how-h" class="t-h2">See how a lesson works</h2>
        <p class="t-muted">Read a little, write a little, and see the answer in front of you.</p>
      </div>
      <ul class="lesson-grid list-none m-0 p-0">
        {lessonTiles.map((tile) => (
          <li class="lesson-tile">
            <picture>
              <source srcset={`/images/lessons/${tile.image}.webp`} type="image/webp" />
              <img
                src={`/images/lessons/${tile.image}.png`}
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
                alt={tile.alt}
              />
            </picture>
            <div class="flex flex-col gap-1">
              <h3 class="t-h3">{tile.title}</h3>
              <p class="t-small t-muted">{tile.line}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Paid tracks -->
  <section class="sec" aria-labelledby="paid-h">
    <div class="wrap flex flex-col gap-8">
      <div class="flex flex-col gap-2 max-w-[680px]">
        <div><Badge tone="soon">Coming 2027</Badge></div>
        <h2 id="paid-h" class="t-h2">Paid tracks (coming 2027)</h2>
        <p class="t-muted">Choose a {passes.annual.exact} or a {passes.monthly.exact}. Both cover all three tracks, with one-time payments and no automatic renewal. One business dataset, the ShopVibe online shop, runs through every course. You build the skills analysts use, in your browser, with instant feedback.</p>
      </div>
      <div class="three rsa-card-grid rsa-card-grid--tracks">
        {paidTracks.map((track) => (
          <article class="rsa-card" id={track.id}>
            <div class="rsa-card-badges"><Badge tone="soon">Coming 2027</Badge></div>
            <h3 class="rsa-card-title">{track.title}</h3>
            <p class="rsa-card-text">{track.summary}</p>
            <ul class="t-small t-muted track-list">
              {track.curriculum.map((course) => <li>{course}</li>)}
            </ul>
            <p class="t-small t-muted track-note">{track.note}</p>
          </article>
        ))}
      </div>
      <div>
        <Button variant="secondary" href="/#signup">Hear when the tracks open</Button>
      </div>
    </div>
  </section>

  <!-- Sign-up CTA -->
  <section class="sec flush" aria-labelledby="cta-h">
    <div class="wrap">
      <div class="flex flex-wrap gap-6 items-center justify-between bg-surface-tint rounded-lg p-10">
        <div class="flex flex-col gap-2 flex-[1_1_420px] min-w-0">
          <h2 id="cta-h" class="t-h2">Hear when the free courses open</h2>
          <p class="t-muted">We'll email you when Introduction to R opens.</p>
        </div>
        <Button href="/#signup">Get updates</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-sec { padding-top: 96px; padding-bottom: 64px; }
  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .track-list { margin: 0; padding-left: 20px; list-style: disc; display: flex; flex-direction: column; gap: 4px; }
  .lesson-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .lesson-grid > .lesson-tile { display: grid; grid-template-rows: subgrid; grid-row: span 2; row-gap: var(--space-3); align-content: start; min-width: 0; }
  .lesson-tile picture { display: block; min-width: 0; }
  .lesson-tile img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--bg); }
  .flush { padding-top: 0; }
  @media (max-width: 900px) {
    .lesson-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .three { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .lesson-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
